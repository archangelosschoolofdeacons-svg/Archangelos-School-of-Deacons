# Supabase project URL, e.g. https://YOUR_PROJECT.supabase.co
SUPABASE_URL=
# Supabase service_role key. SECRET: server-side only; never prefix with NEXT_PUBLIC_ or VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Choose a unique random string of at least 32 characters.
ARCHANGELOS_SESSION_SECRET=
# Admin username and password (password must be at least 12 characters).
ARCHANGELOS_ADMIN_USERNAME=admin
ARCHANGELOS_ADMIN_PASSWORD=
