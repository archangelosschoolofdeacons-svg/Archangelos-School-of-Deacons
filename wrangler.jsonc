{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archangelos-school-of-deacons",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "archangelos-school-materials"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "archangelos-school-content",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ARCHANGELOS_ADMIN_USERNAME": "admin",
    "MAX_UPLOAD_BYTES": "5368709120",
    "MAX_STORAGE_BYTES": "8000000000"
  }
}
