{
  "name": "archangelos-school-of-deacons",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "test": "node --test",
    "check": "node --check src/worker.js && node --check public/app.js && node --check public/localization.js && node --check public/sw.js",
    "db:migrate:local": "wrangler d1 migrations apply archangelos-school-content --local",
    "db:migrate:remote": "wrangler d1 migrations apply archangelos-school-content --remote"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
